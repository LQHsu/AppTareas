# Copia este archivo a ".env" (mismo folder) y rellena valores reales.
# El ".env" NUNCA se commitea (ver .gitignore de este folder).

# --- Postgres interno de Keycloak (solo guarda realms/clients/cache de
#     Keycloak - NO es la BD institucional de correo/area, esa se
#     configura aparte en la Fase 3) ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=cambia-esto

# --- Admin inicial de Keycloak (solo se usa la primera vez que arranca) ---
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=cambia-esto

# --- Hostname que Keycloak anuncia en las URLs que genera ---
# Dev: localhost. Produccion (Fase 6): el dominio real (ej. apptareas-sso.xoc.uam.mx).
KC_HOSTNAME=localhost
