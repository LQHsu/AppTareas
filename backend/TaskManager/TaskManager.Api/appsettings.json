{
  "ConnectionStrings": {
    // Placeholder - la connection string real (con password) va en
    // appsettings.Local.json (gitignored, no versionado). Copia
    // appsettings.Local.json.example a appsettings.Local.json y pon los
    // valores reales de tu entorno.
    "Default": "Server=localhost,1433;Database=TaskManagerDb;User Id=taskmanager_app;Password=CAMBIAR-en-appsettings.Local.json;TrustServerCertificate=True;Encrypt=True"
  },
  "Keycloak": {
    // Keycloak propio (docker/keycloak/), reemplaza al compartido
    // appcafeteria/cafeteria-uam desde el corte a produccion (2026-09-14).
    "Authority": "https://apptareas.xoc.uam.mx/auth-server/realms/apptareas",
    "ClientId": "task-manager-uamx"
  },
  "AllowedOrigins": [
    "http://localhost:4200",
    "https://apptareas.xoc.uam.mx"
  ],
  "Storage": {
    // Vacio = usa <ContentRoot>/App_Data/attachments. En produccion,
    // apuntar a una ruta fuera de la carpeta de deploy para que un
    // redeploy no borre los adjuntos ya subidos.
    "AttachmentsPath": ""
  },
  "InfoUsuariosUnidad": {
    // Placeholder - mismas credenciales que ya se dieron de alta en
    // Keycloak Admin Console -> User federation -> cusxacdi-uamx (BD
    // MySQL institucional, 148.206.99.178). Real value va en
    // appsettings.Local.json (gitignored). Vacio = la vista de "Dar de
    // alta" no muestra preview de correo/area, sigue funcionando igual.
    "ConnectionString": ""
  },
  "Email": {
    // Relay SMTP institucional interno (xsmtp.xoc.uam.mx) - el mismo
    // que ya usa appcafeteria en produccion. Host/Port/User/Password
    // reales van en appsettings.Local.json (gitignored); Host vacio
    // deshabilita el envio de correo (EmailService.Enabled), el resto
    // de la app sigue funcionando igual sin esto configurado.
    "Host": "",
    "Port": 25,
    "User": "",
    "Password": "",
    "FromAddress": "apptareas@xsmtp.xoc.uam.mx",
    "FromName": "UAMX — Gestor de Tareas"
  },
  "GoogleChat": {
    // ServiceAccountJsonBase64: Base64 del JSON completo de la cuenta de
    // servicio de la app de Chat (App Authentication) - NUNCA se pega
    // aqui ni se versiona, va directo en appsettings.Local.json
    // (gitignored). Vacio = Chat deshabilitado (GoogleChatClient.Enabled),
    // el resto de la app sigue funcionando igual sin esto configurado.
    "ServiceAccountJsonBase64": "",
    // Audiencia esperada del JWT que Google manda a /api/chat/interactions
    // (modo "HTTP endpoint URL" elegido al configurar la app en Cloud
    // Console) - no es secreta, es la misma URL publica del endpoint.
    "InteractionsAudience": "https://apptareas.xoc.uam.mx/api/chat/interactions"
  }
}